<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>local.pagequay.gateway</string>
<key>ProgramArguments</key><array><string>/bin/zsh</string><string>/ABSOLUTE/PATH/PageQuay/scripts/start.sh</string></array>
<key>WorkingDirectory</key><string>/ABSOLUTE/PATH/PageQuay</string>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
<key>ThrottleInterval</key><integer>30</integer>
<key>LimitLoadToSessionType</key><string>Aqua</string>
<key>StandardOutPath</key><string>/ABSOLUTE/DATA/PATH/logs/launchd.out.log</string>
<key>StandardErrorPath</key><string>/ABSOLUTE/DATA/PATH/logs/launchd.err.log</string>
</dict></plist>

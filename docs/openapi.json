  "components": {
    "schemas": {
      "Action": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "click",
              "fill",
              "select",
              "scroll",
              "wait_for_selector",
              "wait_for_navigation"
            ],
            "title": "Type"
          },
          "selector": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Selector"
          },
          "value": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "x": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": -10000.0,
            "title": "X",
            "default": 0
          },
          "y": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": -10000.0,
            "title": "Y",
            "default": 0
          },
          "timeout_ms": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 100.0,
            "title": "Timeout Ms",
            "default": 5000
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type"
        ],
        "title": "Action"
      },
      "Actions": {
        "properties": {
          "actions": {
            "items": {
              "$ref": "#/components/schemas/Action"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Actions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "actions"
        ],
        "title": "Actions"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "additionalProperties": true,
            "type": "object",
            "title": "Error",
            "description": "code/message/request_id and optional structured details"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "waiting_for_human",
              "completed",
              "failed",
              "cancelled"
            ],
            "title": "Status"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          },
          "updated_at": {
            "type": "number",
            "title": "Updated At"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SearchResult"
              },
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "error": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "tab_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tab Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "kind",
          "status",
          "created_at",
          "updated_at",
          "result",
          "error",
          "tab_id"
        ],
        "title": "JobResponse"
      },
      "KeyInfo": {
        "properties": {
          "key_id": {
            "type": "string",
            "title": "Key Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "prefix": {

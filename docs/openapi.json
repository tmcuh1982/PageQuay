            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Navigate": {
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Url"
          },
          "wait_until": {
            "type": "string",
            "enum": [
              "domcontentloaded",
              "load",
              "networkidle"
            ],
            "title": "Wait Until",
            "default": "domcontentloaded"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url"
        ],
        "title": "Navigate"
      },
      "Search": {
        "properties": {
          "engine": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "auto",
                  "duckduckgo",
                  "google",
                  "brave"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Engine"
          },
          "strategy": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "fallback",
                  "merge"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Strategy"
          },
          "query": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Query"
          },
          "limit": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 10
          },
          "locale": {
            "type": "string",
            "pattern": "^[a-z]{2}-[A-Z]{2}$",
            "title": "Locale",
            "default": "fr-FR"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [

      "Search": {
        "properties": {
          "engine": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "auto",
                  "duckduckgo",
                  "google",
                  "brave"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Engine"
          },
          "strategy": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "fallback",
                  "merge"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Strategy"
          },
          "query": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Query"
          },
          "limit": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 10
          },
          "locale": {
            "type": "string",
            "pattern": "^[a-z]{2}-[A-Z]{2}$",
            "title": "Locale",
            "default": "fr-FR"
          },
          "cursor": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 43,
                "minLength": 43,
                "pattern": "^[A-Za-z0-9_-]{43}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cursor",
            "description": "Opaque DuckDuckGo continuation; keep query, engine and locale unchanged."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query"
        ],
        "title": "Search",
        "examples": [
          {
            "engine": "duckduckgo",
            "limit": 10,
            "locale": "fr-FR",
            "query": "robot agriculture"
          },
          {
            "cursor": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
            "engine": "duckduckgo",
            "limit": 10,
            "locale": "fr-FR",
            "query": "robot agriculture"
          }
        ]
      },

  "components": {
    "schemas": {
      "Action": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "click",
              "fill",
              "select",
              "scroll",
              "wait_for_selector",
              "wait_for_navigation"
            ],
            "title": "Type"
          },
          "selector": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Selector"
          },
          "value": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "x": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": -10000.0,
            "title": "X",
            "default": 0
          },
          "y": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": -10000.0,
            "title": "Y",
            "default": 0
          },
          "timeout_ms": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 100.0,
            "title": "Timeout Ms",
            "default": 5000
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type"
        ],
        "title": "Action"
      },
      "Actions": {
        "properties": {
          "actions": {
            "items": {
              "$ref": "#/components/schemas/Action"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Actions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "actions"
        ],
        "title": "Actions"
      },
      "HTTPValidationError": {
        "properties": {

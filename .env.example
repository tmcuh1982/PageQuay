# Copy to .env; never commit secrets or browser profiles.
PQ_DATA_DIR="/Users/CHANGE_ME/Library/Application Support/PageQuay"
PQ_PORT=8765
PQ_API_PORT=8766
PQ_DEVELOPMENT=false
PQ_SECURE_COOKIES=false
PQ_BROWSER_CHANNEL=chromium
PQ_ALLOWED_HOSTS=["127.0.0.1","localhost"]
PQ_ALLOWED_ORIGINS=["http://127.0.0.1:8765","http://localhost:8765"]
# For Tailscale Serve, add your exact machine tailnet hostname to PQ_ALLOWED_HOSTS.
# Proxy only the API listener on 8766; keep admin origins local and Secure=false
# for administration over HTTP loopback. Admin initialization: pq init-admin.
